Prove the broker will not hand a secret to an unverified upstream

The broker holds the real credential, and the guest's only resolver is
the gateway -- so if an upstream whose certificate does not verify still
received the credential, poisoned DNS anywhere above us would be enough
to collect it.

It already verifies: Handle passes nil roots, which is the system trust
store, with ServerName set and no InsecureSkipVerify anywhere. That was
a comment in the code and nothing more, so this asserts it -- the
handshake fails, the request is never forwarded, and the upstream never
sees the secret.

diff --git a/pkg/broker/broker_test.go b/pkg/broker/broker_test.go
index 33a20e1..2db78be 100644
--- a/pkg/broker/broker_test.go
+++ b/pkg/broker/broker_test.go
@@ -313,3 +313,93 @@ func TestGuestCannotChooseTheHostTheSecretIsSentTo(t *testing.T) {
 		t.Errorf("upstream saw Host %q: the guest chose where a request carrying the real secret was addressed", seenHost)
 	}
 }
+
+// Intercepting the guest must not mean the broker stops checking who it is
+// talking to. It holds the real secret, and the guest's own resolver is the
+// gateway -- so if an upstream whose certificate does not verify still got the
+// credential, poisoned DNS anywhere above us would be enough to collect it.
+func TestSecretIsNotSentToAnUpstreamThatDoesNotVerify(t *testing.T) {
+	const real = "sk-the-real-secret"
+
+	var seenAuth string
+	var reached bool
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("listen: %v", err)
+	}
+	defer listener.Close()
+
+	serverCA, err := NewCA()
+	if err != nil {
+		t.Fatalf("server CA: %v", err)
+	}
+	serverLeaf, err := serverCA.LeafFor("api.example.test")
+	if err != nil {
+		t.Fatalf("server leaf: %v", err)
+	}
+	upstream := &http.Server{Handler: http.HandlerFunc(
+		func(w http.ResponseWriter, r *http.Request) {
+			reached = true
+			seenAuth = r.Header.Get("x-api-key")
+			w.WriteHeader(http.StatusOK)
+		})}
+	go upstream.Serve(tls.NewListener(listener, &tls.Config{
+		Certificates: []tls.Certificate{*serverLeaf},
+	}))
+	defer upstream.Close()
+
+	address := listener.Addr().String()
+	host := "api.example.test"
+	b, err := Load(writeConfig(t, []Credential{
+		{Domain: host, Header: "x-api-key", Value: real},
+	}))
+	if err != nil || b == nil {
+		t.Fatalf("Load: %v", err)
+	}
+
+	guestSide, brokerSide := net.Pipe()
+
+	// A root store holding a real but unrelated CA: the position the broker is
+	// in when an upstream is not who it claims to be.
+	otherCA, err := NewCA()
+	if err != nil {
+		t.Fatalf("unrelated CA: %v", err)
+	}
+	wrongRoots := x509.NewCertPool()
+	wrongRoots.AppendCertsFromPEM(otherCA.CertPEM())
+
+	done := make(chan error, 1)
+	go func() {
+		done <- b.handleWithRoots(brokerSide, host, func() (net.Conn, error) {
+			return net.Dial("tcp", address)
+		}, wrongRoots)
+	}()
+
+	guestPool := x509.NewCertPool()
+	guestPool.AppendCertsFromPEM(b.CA().CertPEM())
+	client := tls.Client(guestSide, &tls.Config{
+		ServerName: host, RootCAs: guestPool,
+	})
+	req, _ := http.NewRequest("GET", "https://"+host+"/v1/messages", nil)
+	req.Header.Set("x-api-key", "airlock-managed")
+	// Written from a goroutine: net.Pipe is unbuffered, and the broker fails
+	// the upstream handshake before it ever reads the request, so this would
+	// otherwise block until the connection is torn down.
+	go func() { _ = req.Write(client) }()
+
+	// Rejecting a certificate takes seconds here: the platform verifier's
+	// failure path, not anything this sets up -- an empty root pool is just as
+	// slow. Failing closed slowly is still failing closed, and the path where
+	// a certificate does verify stays in the milliseconds.
+	if err = <-done; err == nil {
+		t.Error("the broker reported success against an upstream it could not verify")
+	}
+	if reached {
+		t.Error("the request was forwarded to an upstream whose certificate did not verify")
+	}
+	if seenAuth == real {
+		t.Errorf("the real secret was sent to an unverified upstream")
+	}
+	client.Close()
+	guestSide.Close()
+}
