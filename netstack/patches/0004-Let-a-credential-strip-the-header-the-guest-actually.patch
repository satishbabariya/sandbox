From 9d409de44d608ed364d28456208149a13cdf9171 Mon Sep 17 00:00:00 2001
From: t <t@t>
Date: Wed, 26 Aug 2026 11:59:34 +0530
Subject: [PATCH 4/4] Let a credential strip the header the guest actually sent

---
 pkg/broker/broker.go      | 11 +++++++++++
 pkg/broker/broker_test.go | 34 ++++++++++++++++++++++++++++++++++
 2 files changed, 45 insertions(+)

diff --git a/pkg/broker/broker.go b/pkg/broker/broker.go
index d70d7a7..0ac19bf 100644
--- a/pkg/broker/broker.go
+++ b/pkg/broker/broker.go
@@ -19,6 +19,14 @@ type Credential struct {
 	Domain string `json:"domain"`
 	Header string `json:"header"`
 	Value  string `json:"value"`
+	// Headers to remove before injecting.
+	//
+	// An agent may authenticate a different way than the credential does: one
+	// signed in with OAuth still sends x-api-key when an API-key environment
+	// variable is set. Leaving that header in place sends the sentinel
+	// alongside the real token, and the server rejects the request on the
+	// sentinel.
+	Replace []string `json:"replace,omitempty"`
 }
 
 type config struct {
@@ -158,6 +166,9 @@ func (b *Broker) handleWithRoots(
 		}
 
 		// The substitution. The guest's sentinel never reaches the wire.
+		for _, header := range cred.Replace {
+			req.Header.Del(header)
+		}
 		req.Header.Set(cred.Header, cred.Value)
 		req.URL.Scheme = "https"
 		req.URL.Host = name
diff --git a/pkg/broker/broker_test.go b/pkg/broker/broker_test.go
index 030352b..781c86f 100644
--- a/pkg/broker/broker_test.go
+++ b/pkg/broker/broker_test.go
@@ -202,3 +202,37 @@ func TestSentinelIsReplacedBeforeItLeavesTheHost(t *testing.T) {
 		t.Errorf("upstream saw %q, want the real secret", seenAuth)
 	}
 }
+
+// An agent signed in with OAuth still sends x-api-key when an API-key
+// environment variable is set. Both headers reaching the server means the
+// sentinel is evaluated alongside the real token, and the request is rejected.
+func TestReplacedHeadersAreStripped(t *testing.T) {
+	b, err := Load(writeConfig(t, []Credential{{
+		Domain:  "api.example.com",
+		Header:  "authorization",
+		Value:   "Bearer real-token",
+		Replace: []string{"x-api-key"},
+	}}))
+	if err != nil || b == nil {
+		t.Fatalf("Load: %v", err)
+	}
+
+	b.mu.RLock()
+	cred := b.creds["api.example.com"]
+	b.mu.RUnlock()
+
+	req, _ := http.NewRequest("GET", "https://api.example.com/v1/x", nil)
+	req.Header.Set("x-api-key", "airlock-managed")
+
+	for _, header := range cred.Replace {
+		req.Header.Del(header)
+	}
+	req.Header.Set(cred.Header, cred.Value)
+
+	if got := req.Header.Get("x-api-key"); got != "" {
+		t.Errorf("x-api-key should have been removed, got %q", got)
+	}
+	if got := req.Header.Get("authorization"); got != "Bearer real-token" {
+		t.Errorf("authorization = %q, want the real token", got)
+	}
+}
