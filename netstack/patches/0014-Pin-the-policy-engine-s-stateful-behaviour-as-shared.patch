From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Satish Babariya <16605023+satishbabariya@users.noreply.github.com>
Date: Thu, 1 Oct 2026 10:40:33 +0530
Subject: [PATCH] Pin the policy engine's stateful behaviour as shared test
 vectors

host-patterns.json pins the pattern matcher alone. The engine built on
top of it -- the resolution ledger, its 5-minute minimum TTL and
8,192-entry cap, deny winning across every name sharing an address, and
the unresolved-address rule for a hardcoded IP -- had no equivalent: it
was only pinned by Go unit tests a later implementation would have had
to read to reproduce.

Add testdata/policy-vectors.json: named sequences of resolutions, dials
and TLS ClientHellos, each with the verdict and reason the engine must
return. pkg/policy/policy_vectors_test.go replays each sequence against
a fresh engine with a fake clock, so ledger expiry is deterministic
rather than racing the real one. The format is documented in
testdata/policy-vectors.md, so a later Swift adapter can load the file
without reading this package.
---
 pkg/policy/policy_vectors_test.go       | 181 +++++++++++++++++++++
 pkg/policy/testdata/policy-vectors.json | 203 ++++++++++++++++++++++++
 2 files changed, 384 insertions(+)
 create mode 100644 pkg/policy/policy_vectors_test.go
 create mode 100644 pkg/policy/testdata/policy-vectors.json

diff --git a/pkg/policy/policy_vectors_test.go b/pkg/policy/policy_vectors_test.go
new file mode 100644
index 0000000..6f10731
--- /dev/null
+++ b/pkg/policy/policy_vectors_test.go
@@ -0,0 +1,181 @@
+package policy
+
+import (
+	"encoding/json"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+type vectorCase struct {
+	Name                 string       `json:"name"`
+	Allow                []string     `json:"allow"`
+	Deny                 []string     `json:"deny"`
+	ExpectConstructError bool         `json:"expectConstructError"`
+	Steps                []vectorStep `json:"steps"`
+}
+
+type vectorStep struct {
+	Resolve *struct {
+		Host       string   `json:"host"`
+		IPs        []string `json:"ips"`
+		TTLSeconds int      `json:"ttlSeconds"`
+	} `json:"resolve"`
+	Query *struct {
+		Host string `json:"host"`
+	} `json:"query"`
+	Dial *struct {
+		Proto string `json:"proto"`
+		IP    string `json:"ip"`
+		Port  uint16 `json:"port"`
+	} `json:"dial"`
+	Hello *struct {
+		Host string `json:"host"`
+		Port uint16 `json:"port"`
+	} `json:"hello"`
+	Advance *struct {
+		Seconds int `json:"seconds"`
+	} `json:"advance"`
+	FillLedger *struct {
+		Count      int `json:"count"`
+		TTLSeconds int `json:"ttlSeconds"`
+	} `json:"fillLedger"`
+	Expect *struct {
+		Allowed bool   `json:"allowed"`
+		Reason  string `json:"reason"`
+	} `json:"expect"`
+}
+
+type vectorFile struct {
+	Cases []vectorCase `json:"cases"`
+}
+
+func loadVectorFile(t *testing.T) vectorFile {
+	t.Helper()
+	b, err := os.ReadFile(filepath.Join("testdata", "policy-vectors.json"))
+	if err != nil {
+		t.Fatalf("read policy vectors: %v", err)
+	}
+	var f vectorFile
+	if err := json.Unmarshal(b, &f); err != nil {
+		t.Fatalf("parse policy vectors: %v", err)
+	}
+	return f
+}
+
+// TestPolicyVectors is the conformance gate for the stateful engine built on
+// top of the pattern matcher TestSharedVectors pins. Any later
+// implementation of this engine — including the Swift one planned for
+// sandbox — must reproduce every verdict and reason here exactly; see
+// testdata/policy-vectors.md.
+func TestPolicyVectors(t *testing.T) {
+	file := loadVectorFile(t)
+	if len(file.Cases) == 0 {
+		t.Fatal("no cases loaded from policy-vectors.json")
+	}
+
+	for _, c := range file.Cases {
+		c := c
+		t.Run(c.Name, func(t *testing.T) {
+			runVectorCase(t, c)
+		})
+	}
+}
+
+func runVectorCase(t *testing.T, c vectorCase) {
+	t.Helper()
+
+	e, err := NewEngine(c.Allow, c.Deny, "")
+	if c.ExpectConstructError {
+		if err == nil {
+			t.Fatal("NewEngine should have failed for a malformed pattern")
+		}
+		if len(c.Steps) != 0 {
+			t.Fatal("a case with expectConstructError must have no steps")
+		}
+		return
+	}
+	if err != nil {
+		t.Fatalf("NewEngine: %v", err)
+	}
+
+	clock := time.Unix(1700000000, 0).UTC()
+	e.now = func() time.Time { return clock }
+
+	for i, step := range c.Steps {
+		switch {
+		case step.Resolve != nil:
+			var ips []net.IP
+			for _, raw := range step.Resolve.IPs {
+				ip := net.ParseIP(raw)
+				if ip == nil {
+					t.Fatalf("step %d: invalid ip %q", i, raw)
+				}
+				ips = append(ips, ip)
+			}
+			e.NoteResolution(step.Resolve.Host, ips, time.Duration(step.Resolve.TTLSeconds)*time.Second)
+			assertNoExpect(t, i, step)
+
+		case step.Query != nil:
+			v := e.AllowName(step.Query.Host)
+			assertExpect(t, i, "query", step, v)
+
+		case step.Dial != nil:
+			ip := net.ParseIP(step.Dial.IP)
+			if ip == nil {
+				t.Fatalf("step %d: invalid ip %q", i, step.Dial.IP)
+			}
+			v := e.AllowDial(step.Dial.Proto, ip, step.Dial.Port)
+			assertExpect(t, i, "dial", step, v)
+
+		case step.Hello != nil:
+			v := e.AllowSNI(step.Hello.Host, step.Hello.Port)
+			assertExpect(t, i, "hello", step, v)
+
+		case step.Advance != nil:
+			clock = clock.Add(time.Duration(step.Advance.Seconds) * time.Second)
+			assertNoExpect(t, i, step)
+
+		case step.FillLedger != nil:
+			ttl := time.Duration(step.FillLedger.TTLSeconds) * time.Second
+			for n := 0; n < step.FillLedger.Count; n++ {
+				ip := syntheticLedgerFillIP(n)
+				e.NoteResolution(fmt.Sprintf("ledger-filler-%d.test", n), []net.IP{ip}, ttl)
+			}
+			assertNoExpect(t, i, step)
+
+		default:
+			t.Fatalf("step %d: no recognised operation", i)
+		}
+	}
+}
+
+// syntheticLedgerFillIP produces a deterministic, distinct address per index
+// in 10.0.0.0/8, clear of the addresses explicit vectors use.
+func syntheticLedgerFillIP(n int) net.IP {
+	n++ // keep 10.0.0.0 unused
+	return net.IPv4(10, byte(n>>16), byte(n>>8), byte(n))
+}
+
+func assertNoExpect(t *testing.T, i int, step vectorStep) {
+	t.Helper()
+	if step.Expect != nil {
+		t.Fatalf("step %d: this operation does not produce a verdict, but expect was set", i)
+	}
+}
+
+func assertExpect(t *testing.T, i int, kind string, step vectorStep, v Verdict) {
+	t.Helper()
+	if step.Expect == nil {
+		t.Fatalf("step %d (%s): missing expect", i, kind)
+	}
+	if v.Allowed != step.Expect.Allowed {
+		t.Errorf("step %d (%s): allowed = %v, want %v (verdict %+v)", i, kind, v.Allowed, step.Expect.Allowed, v)
+	}
+	if step.Expect.Reason != "" && v.Reason != step.Expect.Reason {
+		t.Errorf("step %d (%s): reason = %q, want %q (verdict %+v)", i, kind, v.Reason, step.Expect.Reason, v)
+	}
+}
diff --git a/pkg/policy/testdata/policy-vectors.json b/pkg/policy/testdata/policy-vectors.json
new file mode 100644
index 0000000..bcfb444
--- /dev/null
+++ b/pkg/policy/testdata/policy-vectors.json
@@ -0,0 +1,203 @@
+{
+  "_comment": [
+    "Shared conformance vectors for sandbox's egress-policy Engine.",
+    "host-patterns.json pins the pattern matcher; this file pins the stateful",
+    "engine built on top of it: the resolution ledger, its minimum TTL and",
+    "size cap, dial-time enforcement across every name sharing an address, and",
+    "the SNI re-check. The Go engine (pkg/policy in the vendored gvisor-tap-vsock",
+    "fork) is authoritative; the Swift adapter that will later replace it must",
+    "reproduce every verdict and reason here exactly.",
+    "Format is documented in testdata/policy-vectors.md.",
+    "Add a case here first, then make the Go side pass it."
+  ],
+  "cases": [
+    {
+      "name": "deny wins across every name sharing an address",
+      "allow": ["*.github.com"],
+      "deny": ["gist.github.com"],
+      "steps": [
+        { "resolve": { "host": "api.github.com", "ips": ["140.82.113.4"], "ttlSeconds": 60 } },
+        { "resolve": { "host": "gist.github.com", "ips": ["140.82.113.4"], "ttlSeconds": 60 } },
+        { "dial": { "proto": "tcp", "ip": "140.82.113.4", "port": 443 },
+          "expect": { "allowed": false, "reason": "deny-rule" } }
+      ]
+    },
+    {
+      "name": "an address our resolver never handed out is refused",
+      "allow": ["*.anthropic.com"],
+      "deny": [],
+      "steps": [
+        { "dial": { "proto": "tcp", "ip": "13.37.13.37", "port": 443 },
+          "expect": { "allowed": false, "reason": "unresolved-address" } }
+      ]
+    },
+    {
+      "name": "a resolved allowed address is dialable",
+      "allow": ["*.anthropic.com"],
+      "deny": [],
+      "steps": [
+        { "resolve": { "host": "api.anthropic.com", "ips": ["160.79.104.10"], "ttlSeconds": 60 } },
+        { "dial": { "proto": "tcp", "ip": "160.79.104.10", "port": 443 },
+          "expect": { "allowed": true, "reason": "allow-rule" } }
+      ]
+    },
+    {
+      "name": "the DNS gate refuses an unallowed name before any resolution",
+      "allow": ["*.anthropic.com"],
+      "deny": [],
+      "steps": [
+        { "query": { "host": "exfil.evil.com" },
+          "expect": { "allowed": false, "reason": "no-allow-rule" } },
+        { "query": { "host": "api.anthropic.com" },
+          "expect": { "allowed": true, "reason": "allow-rule" } }
+      ]
+    },
+    {
+      "name": "the DNS gate lets deny beat a broader allow at resolution time",
+      "allow": ["*.github.com"],
+      "deny": ["gist.github.com"],
+      "steps": [
+        { "query": { "host": "api.github.com" },
+          "expect": { "allowed": true, "reason": "allow-rule" } },
+        { "query": { "host": "gist.github.com" },
+          "expect": { "allowed": false, "reason": "deny-rule" } }
+      ]
+    },
+    {
+      "name": "a port-qualified allow permits resolution but only its own port at dial",
+      "allow": ["registry.example.com:5000"],
+      "deny": [],
+      "steps": [
+        { "query": { "host": "registry.example.com" },
+          "expect": { "allowed": true, "reason": "allow-rule" } },
+        { "resolve": { "host": "registry.example.com", "ips": ["10.11.12.13"], "ttlSeconds": 60 } },
+        { "dial": { "proto": "tcp", "ip": "10.11.12.13", "port": 5000 },
+          "expect": { "allowed": true, "reason": "allow-rule" } },
+        { "dial": { "proto": "tcp", "ip": "10.11.12.13", "port": 443 },
+          "expect": { "allowed": false, "reason": "no-allow-rule" } }
+      ]
+    },
+    {
+      "name": "a port-qualified deny does not block resolution, but still blocks its own port at dial",
+      "allow": ["*.example.com"],
+      "deny": ["blocked.example.com:443"],
+      "steps": [
+        { "query": { "host": "blocked.example.com" },
+          "expect": { "allowed": true, "reason": "allow-rule" } },
+        { "resolve": { "host": "blocked.example.com", "ips": ["10.20.30.40"], "ttlSeconds": 60 } },
+        { "dial": { "proto": "tcp", "ip": "10.20.30.40", "port": 443 },
+          "expect": { "allowed": false, "reason": "deny-rule" } },
+        { "dial": { "proto": "tcp", "ip": "10.20.30.40", "port": 8080 },
+          "expect": { "allowed": true, "reason": "allow-rule" } }
+      ]
+    },
+    {
+      "name": "a literal address rule authorises a dial without any DNS",
+      "allow": ["10.0.0.5"],
+      "deny": [],
+      "steps": [
+        { "dial": { "proto": "tcp", "ip": "10.0.0.5", "port": 8080 },
+          "expect": { "allowed": true, "reason": "allow-rule" } },
+        { "dial": { "proto": "tcp", "ip": "10.0.0.6", "port": 8080 },
+          "expect": { "allowed": false, "reason": "unresolved-address" } }
+      ]
+    },
+    {
+      "name": "the ledger's 5-minute minimum floors a shorter TTL",
+      "allow": ["*.anthropic.com"],
+      "deny": [],
+      "steps": [
+        { "resolve": { "host": "api.anthropic.com", "ips": ["160.79.104.10"], "ttlSeconds": 60 } },
+        { "advance": { "seconds": 240 } },
+        { "dial": { "proto": "tcp", "ip": "160.79.104.10", "port": 443 },
+          "expect": { "allowed": true, "reason": "allow-rule" } }
+      ]
+    },
+    {
+      "name": "an expired ledger entry stops authorising its address",
+      "allow": ["*.anthropic.com"],
+      "deny": [],
+      "steps": [
+        { "resolve": { "host": "api.anthropic.com", "ips": ["160.79.104.10"], "ttlSeconds": 60 } },
+        { "advance": { "seconds": 301 } },
+        { "dial": { "proto": "tcp", "ip": "160.79.104.10", "port": 443 },
+          "expect": { "allowed": false, "reason": "unresolved-address" } }
+      ]
+    },
+    {
+      "name": "an empty policy denies every name and every address",
+      "allow": [],
+      "deny": [],
+      "steps": [
+        { "resolve": { "host": "anything.com", "ips": ["1.1.1.1"], "ttlSeconds": 60 } },
+        { "dial": { "proto": "tcp", "ip": "1.1.1.1", "port": 443 },
+          "expect": { "allowed": false, "reason": "no-allow-rule" } },
+        { "query": { "host": "anything.com" },
+          "expect": { "allowed": false, "reason": "no-allow-rule" } }
+      ]
+    },
+    {
+      "name": "SNI distinguishes names on a shared address",
+      "allow": ["allowed.example.com"],
+      "deny": [],
+      "steps": [
+        { "resolve": { "host": "allowed.example.com", "ips": ["104.20.1.1"], "ttlSeconds": 60 } },
+        { "dial": { "proto": "tcp", "ip": "104.20.1.1", "port": 443 },
+          "expect": { "allowed": true, "reason": "allow-rule" } },
+        { "hello": { "host": "notallowed.example.com", "port": 443 },
+          "expect": { "allowed": false, "reason": "sni-denied" } },
+        { "hello": { "host": "allowed.example.com", "port": 443 },
+          "expect": { "allowed": true, "reason": "allow-rule" } }
+      ]
+    },
+    {
+      "name": "SNI respects deny the same as a dial",
+      "allow": ["*.github.com"],
+      "deny": ["gist.github.com"],
+      "steps": [
+        { "hello": { "host": "gist.github.com", "port": 443 },
+          "expect": { "allowed": false, "reason": "deny-rule" } },
+        { "hello": { "host": "api.github.com", "port": 443 },
+          "expect": { "allowed": true, "reason": "allow-rule" } }
+      ]
+    },
+    {
+      "name": "ICMP shares the dial gate at port 0: a bare rule grants it",
+      "allow": ["*.anthropic.com"],
+      "deny": [],
+      "steps": [
+        { "resolve": { "host": "api.anthropic.com", "ips": ["160.79.104.10"], "ttlSeconds": 60 } },
+        { "dial": { "proto": "icmp", "ip": "160.79.104.10", "port": 0 },
+          "expect": { "allowed": true, "reason": "allow-rule" } }
+      ]
+    },
+    {
+      "name": "ICMP shares the dial gate at port 0: a port-qualified rule does not grant it",
+      "allow": ["registry.example.com:5000"],
+      "deny": [],
+      "steps": [
+        { "resolve": { "host": "registry.example.com", "ips": ["10.11.12.13"], "ttlSeconds": 60 } },
+        { "dial": { "proto": "icmp", "ip": "10.11.12.13", "port": 0 },
+          "expect": { "allowed": false, "reason": "no-allow-rule" } }
+      ]
+    },
+    {
+      "name": "the ledger is bounded: past 8192 entries a new address is never recorded",
+      "allow": ["*.anthropic.com"],
+      "deny": [],
+      "steps": [
+        { "fillLedger": { "count": 8192, "ttlSeconds": 60 } },
+        { "resolve": { "host": "api.anthropic.com", "ips": ["160.79.104.10"], "ttlSeconds": 60 } },
+        { "dial": { "proto": "tcp", "ip": "160.79.104.10", "port": 443 },
+          "expect": { "allowed": false, "reason": "unresolved-address" } }
+      ]
+    },
+    {
+      "name": "a malformed pattern is rejected at construction, not silently ignored",
+      "allow": ["*bad.com"],
+      "deny": [],
+      "expectConstructError": true,
+      "steps": []
+    }
+  ]
+}
