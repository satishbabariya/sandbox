index ebad9a5..cd0e7a0 100644
--- a/pkg/policy/engine.go
+++ b/pkg/policy/engine.go
@@ -22,6 +22,7 @@ type Verdict struct {
 
 const (
 	ReasonAllowRule    = "allow-rule"
+	ReasonSNIDenied    = "sni-denied"
 	ReasonDenyRule     = "deny-rule"
 	ReasonNoAllowRule  = "no-allow-rule"
 	ReasonUnresolvedIP = "unresolved-address"
@@ -252,6 +253,42 @@ func (e *Engine) allowDial(ip net.IP, port uint16) Verdict {
 	return Verdict{Allowed: false, Reason: ReasonNoAllowRule, Names: names}
 }
 
+// AllowSNI re-evaluates a connection against the hostname its TLS ClientHello
+// actually asked for.
+//
+// The ledger can only say which names an address was handed out for. On a
+// shared CDN address that may include names policy does not allow, and the
+// dial check has no way to tell which one this connection wants. The
+// ClientHello does, in the clear, so checking it turns "some allowed name lives
+// here" into "this connection is for an allowed name".
+func (e *Engine) AllowSNI(name string, port uint16) Verdict {
+	e.mu.RLock()
+	defer e.mu.RUnlock()
+
+	v := e.evaluate(normalizeHost(name), port)
+	if !v.Allowed && v.Reason == ReasonNoAllowRule {
+		v.Reason = ReasonSNIDenied
+	}
+	v.Names = []string{name}
+	return v
+}
+
+// RecordSNI writes an SNI decision to the audit log.
+func (e *Engine) RecordSNI(proto string, ip net.IP, port uint16, v Verdict) {
+	e.record(proto, ip, port, v)
+}
+
+// HasRules reports whether any policy is configured. With none, SNI inspection
+// is pointless work on every connection.
+func (e *Engine) HasRules() bool {
+	if e == nil {
+		return false
+	}
+	e.mu.RLock()
+	defer e.mu.RUnlock()
+	return len(e.allow) > 0 || len(e.deny) > 0
+}
+
 type auditRecord struct {
 	Time    string   `json:"time"`
 	Proto   string   `json:"proto"`
diff --git a/pkg/policy/sni_shared_test.go b/pkg/policy/sni_shared_test.go
new file mode 100644
index 0000000..fdb94e0
--- /dev/null
+++ b/pkg/policy/sni_shared_test.go
@@ -0,0 +1,59 @@
+package policy
+
+import (
+	"net"
+	"testing"
+	"time"
+)
+
+// The case SNI exists for: one address, two names, one of them not allowed.
+// The dial check can only see the address, so it must permit the connection —
+// an allowed name does live there. Only the ClientHello says which name this
+// particular connection wants.
+func TestSNIDistinguishesNamesOnASharedAddress(t *testing.T) {
+	e, err := NewEngine([]string{"allowed.example.com"}, nil, "")
+	if err != nil {
+		t.Fatalf("NewEngine: %v", err)
+	}
+
+	shared := net.ParseIP("104.20.1.1")
+	e.NoteResolution("allowed.example.com", []net.IP{shared}, time.Minute)
+
+	// The address is dialable, because a name we allow resolves to it.
+	if v := e.AllowDial("tcp", shared, 443); !v.Allowed {
+		t.Fatalf("shared address should be dialable, got %+v", v)
+	}
+
+	// But a connection asking for a different name on it must be refused.
+	if v := e.AllowSNI("notallowed.example.com", 443); v.Allowed {
+		t.Error("SNI for an unallowed name must be refused")
+	}
+	if v := e.AllowSNI("allowed.example.com", 443); !v.Allowed {
+		t.Error("SNI for the allowed name must pass")
+	}
+}
+
+func TestSNIRespectsDeny(t *testing.T) {
+	e, _ := NewEngine([]string{"*.github.com"}, []string{"gist.github.com"}, "")
+	if v := e.AllowSNI("gist.github.com", 443); v.Allowed {
+		t.Error("deny must win at the SNI check too")
+	}
+	if v := e.AllowSNI("api.github.com", 443); !v.Allowed {
+		t.Error("an allowed name must still pass")
+	}
+}
+
+func TestHasRulesGatesTheWork(t *testing.T) {
+	empty, _ := NewEngine(nil, nil, "")
+	if empty.HasRules() {
+		t.Error("an empty policy has no rules")
+	}
+	withRules, _ := NewEngine([]string{"example.com"}, nil, "")
+	if !withRules.HasRules() {
+		t.Error("a configured policy has rules")
+	}
+	var nilEngine *Engine
+	if nilEngine.HasRules() {
+		t.Error("a nil engine must report no rules rather than panicking")
+	}
+}
