+// inspectAndForward reads the ClientHello, applies policy to the name it
+// advertises, and either splices the connection upstream or drops it.
+//
+// The peeked bytes are replayed verbatim, so the server sees the handshake the
+// guest sent. Nothing is decrypted and no certificate is involved.
+func inspectAndForward(
+	guest net.Conn, ip net.IP, port uint16, dialAddress string,
+	pol *policy.Engine, brk *broker.Broker,
+) {
+	defer guest.Close()
+
+	name, consumed, err := sni.PeekServerName(guest)
+	if err != nil && name == "" {
+		// Not TLS, or no name to check. The dial check already allowed this
+		// address, so forward what we read and splice the rest.
+		if len(consumed) == 0 {
+			return
+		}
+		spliceWithPrefix(guest, dialAddress, consumed)
+		return
+	}
+
+	if v := pol.AllowSNI(name, port); !v.Allowed {
+		log.Infof("policy: refused tls %s (%s) to %s", name, v.Reason, ip)
+		pol.RecordSNI("tcp", ip, port, v)
+		return
+	}
+
+	// A credential bound to this name means the broker must terminate TLS to
+	// substitute it. Replay the ClientHello into it so its handshake sees the
+	// stream from the start.
+	if brk.Intercepts(name) {
+		replayed := &prefixConn{Conn: guest, prefix: consumed}
+		if err := brk.Handle(replayed, name, func() (net.Conn, error) {
+			return net.Dial("tcp", dialAddress)
+		}); err != nil {
+			log.Infof("broker: %s: %v", name, err)
+		}
+		return
+	}
+
+	spliceWithPrefix(guest, dialAddress, consumed)
+}
+
+// prefixConn replays bytes already read from the connection before continuing
+// with the live stream. Peeking the ClientHello consumes it, and anything that
+// wants to speak TLS afterwards has to see it.
+type prefixConn struct {
+	net.Conn
+	prefix []byte
+}
+
+func (c *prefixConn) Read(b []byte) (int, error) {
+	if len(c.prefix) > 0 {
+		n := copy(b, c.prefix)
+		c.prefix = c.prefix[n:]
+		return n, nil
+	}
+	return c.Conn.Read(b)
+}
+
+// spliceWithPrefix dials upstream, replays the bytes already read, then hands
+// both ends to the same proxy the non-inspected path uses.
+//
+// Reusing tcpproxy here rather than copying by hand: getting half-close and
+// teardown right matters, and this path already had a working implementation.
+func spliceWithPrefix(guest net.Conn, dialAddress string, prefix []byte) {
+	upstream, err := net.Dial("tcp", dialAddress)
+	if err != nil {
+		log.Tracef("net.Dial() = %v", err)
+		return
+	}
+
+	if len(prefix) > 0 {
+		if _, err := upstream.Write(prefix); err != nil {
+			upstream.Close()
+			return
 		}
 	}
-	return ""
+
+	remote := tcpproxy.DialProxy{
+		DialContext: func(_ context.Context, _, _ string) (net.Conn, error) {
+			return upstream, nil
+		},
+	}
+	remote.HandleConn(guest)
 }
 
