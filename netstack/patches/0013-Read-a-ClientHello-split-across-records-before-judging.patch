+func TestReassemblesHelloSplitAcrossRecords(t *testing.T) {
+	hello := captureClientHello(t, "gist.github.com")
+	// 38 ends the first record after the random, before anything that names a
+	// host; 1 is the finest split a client can make.
+	for _, size := range []int{1, 4, 38, 100, len(hello) / 2} {
+		split := reframe(t, hello, size)
+		trailing := []byte("next flight")
+		stream := io.MultiReader(bytes.NewReader(split), bytes.NewReader(trailing))
+
+		got, consumed, err := PeekServerName(stream)
+		if err != nil || got != "gist.github.com" {
+			t.Errorf("records of %d bytes: got %q, %v; want the name from the reassembled hello", size, got, err)
+			continue
+		}
+		rest, _ := io.ReadAll(stream)
+		if !bytes.Equal(append(consumed, rest...), append(split, trailing...)) {
+			t.Errorf("records of %d bytes: consumed plus remainder must replay the stream exactly", size)
+		}
+	}
+}
