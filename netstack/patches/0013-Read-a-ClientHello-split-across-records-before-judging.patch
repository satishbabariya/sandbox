+func TestSplitHelloTruncatedIsIncomplete(t *testing.T) {
+	split := reframe(t, captureClientHello(t, "example.com"), 100)
+	for _, cut := range []int{105, 106, 200, len(split) - 1} {
+		_, consumed, err := PeekServerName(bytes.NewReader(split[:cut]))
+		if !errors.Is(err, ErrIncomplete) {
+			t.Errorf("cut at %d: err = %v, want ErrIncomplete", cut, err)
+		}
+		if !bytes.Equal(consumed, split[:cut]) {
+			t.Errorf("cut at %d: consumed must be every byte read", cut)
+		}
+	}
