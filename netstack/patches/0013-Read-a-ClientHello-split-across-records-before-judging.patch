+// Once the stream has started as a handshake, nothing else it does before the
+// hello is whole may be taken to mean "not TLS": that would be forwarded
+// unchecked, and a server may still read a name from what follows.
+func TestHandshakeThatGoesWrongIsMalformedNotNonTLS(t *testing.T) {
+	split := reframe(t, captureClientHello(t, "example.com"), 38)
+	firstRecord := split[:5+38]
+	cases := map[string][]byte{
+		"application data before the hello is whole": append(append([]byte{}, firstRecord...), 0x17, 0x03, 0x03, 0x00, 0x01, 0x00),
+		"zero-length handshake record":               {0x16, 0x03, 0x01, 0x00, 0x00},
+		"record over the TLS limit":                  {0x16, 0x03, 0x01, 0x40, 0x01},
+		"handshake that is not a ClientHello":        {0x16, 0x03, 0x01, 0x00, 0x04, 0x02, 0x00, 0x00, 0x00},
+		"hello claiming more than maxHello":          {0x16, 0x03, 0x01, 0x00, 0x04, 0x01, 0x00, 0x40, 0x01},
+	}
+	for name, input := range cases {
+		if _, _, err := PeekServerName(bytes.NewReader(input)); !errors.Is(err, ErrMalformed) {
+			t.Errorf("%s: err = %v, want ErrMalformed", name, err)
+		}
+	}
+}
