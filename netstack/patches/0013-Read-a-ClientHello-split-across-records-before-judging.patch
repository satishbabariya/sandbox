+// reframe splits the handshake carried by a single-record hello into records
+// of at most size bytes each, the way a client is allowed to.
+func reframe(t *testing.T, hello []byte, size int) []byte {
+	t.Helper()
+	end := 5 + (int(hello[3])<<8 | int(hello[4]))
+	body := hello[5:end]
+	var out []byte
+	for len(body) > 0 {
+		n := min(size, len(body))
+		out = append(out, hello[0], hello[1], hello[2], byte(n>>8), byte(n))
+		out = append(out, body[:n]...)
+		body = body[n:]
+	}
+	return append(out, hello[end:]...)
+}
