@@ -0,0 +1,306 @@
+package forwarder
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"io"
+	"math/big"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/policy"
+)
+
+// A ClientHello may be split across several TLS records, and servers
+// reassemble it: crypto/tls reads records until the handshake message is
+// whole. These tests put a real crypto/tls client and a real crypto/tls
+// server on either side of inspectAndForward and re-frame the client's hello
+// into two records, so what they prove is what a server upstream would accept,
+// not what our own parser happens to like.
+
+// cutAt is where the hello is split: after the handshake header, version and
+// random. The first record then holds no session id, no cipher suites and no
+// extensions, so the server name can only be found by reading the second.
+const cutAt = 4 + 2 + 32
+
+// splitFirstRecord re-frames the first TLS record written through it into two
+// records, split at cutAt, and passes everything after it through untouched.
+type splitFirstRecord struct {
+	net.Conn
+	pending []byte
+	done    bool
+}
+
+func (c *splitFirstRecord) Write(b []byte) (int, error) {
+	if c.done {
+		return c.Conn.Write(b)
+	}
+	c.pending = append(c.pending, b...)
+	if len(c.pending) < 5 {
+		return len(b), nil
+	}
+	end := 5 + (int(c.pending[3])<<8 | int(c.pending[4]))
+	if len(c.pending) < end {
+		return len(b), nil
+	}
+	c.done = true
+
+	header, body := c.pending[:3], c.pending[5:end]
+	var out []byte
+	for _, part := range [][]byte{body[:cutAt], body[cutAt:]} {
+		out = append(out, header...)
+		out = append(out, byte(len(part)>>8), byte(len(part)))
+		out = append(out, part...)
+	}
+	out = append(out, c.pending[end:]...)
+	if _, err := c.Conn.Write(out); err != nil {
+		return 0, err
+	}
+	return len(b), nil
+}
+
+// upstreamResult is what the real TLS server behind the gate saw.
+type upstreamResult struct {
+	serverName string // the SNI its handshake was asked for, "" if none arrived
+	err        error  // nil once a full handshake completed
+}
+
+// tlsUpstream starts a crypto/tls server for names and returns a connection to
+// it, plus the pool that trusts its certificate and the result of the one
+// handshake it serves.
+func tlsUpstream(t *testing.T, names ...string) (net.Conn, *x509.CertPool, <-chan upstreamResult) {
+	t.Helper()
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	template := &x509.Certificate{
+		SerialNumber: big.NewInt(1),
+		Subject:      pkix.Name{CommonName: names[0]},
+		DNSNames:     names,
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().Add(time.Hour),
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		t.Fatal(err)
+	}
+	leaf, err := x509.ParseCertificate(der)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pool := x509.NewCertPool()
+	pool.AddCert(leaf)
+
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { ln.Close() })
+
+	result := make(chan upstreamResult, 1)
+	go func() {
+		conn, err := ln.Accept()
+		if err != nil {
+			result <- upstreamResult{err: err}
+			return
+		}
+		defer conn.Close()
+		conn.SetDeadline(time.Now().Add(10 * time.Second))
+		var seen string
+		server := tls.Server(conn, &tls.Config{
+			GetCertificate: func(hello *tls.ClientHelloInfo) (*tls.Certificate, error) {
+				seen = hello.ServerName
+				return &tls.Certificate{Certificate: [][]byte{der}, PrivateKey: key}, nil
+			},
+		})
+		err = server.Handshake()
+		result <- upstreamResult{serverName: seen, err: err}
+	}()
+
+	upstream, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return upstream, pool, result
+}
+
+// The rule from the issue: a wildcard that allows a CDN's names, and a deny
+// for one of them that shares its addresses.
+func splitTestEngine(t *testing.T) *policy.Engine {
+	t.Helper()
+	e, err := policy.NewEngine([]string{"*.github.com"}, []string{"gist.github.com"}, "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	return e
+}
+
+// handshakeThroughGate runs a real TLS client for serverName, its hello split
+// in two records, through inspectAndForward to a real TLS server. It returns
+// the client's handshake error and what the server saw.
+func handshakeThroughGate(t *testing.T, serverName string) (error, upstreamResult) {
+	t.Helper()
+	upstream, pool, result := tlsUpstream(t, "gist.github.com", "api.github.com")
+
+	guest, client := net.Pipe()
+	go inspectAndForward(guest, upstream, net.ParseIP("127.0.0.1"), 443, splitTestEngine(t), nil)
+
+	conn := tls.Client(&splitFirstRecord{Conn: client}, &tls.Config{
+		ServerName: serverName,
+		RootCAs:    pool,
+	})
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(10 * time.Second))
+	clientErr := conn.Handshake()
+	conn.Close()
+
+	select {
+	case r := <-result:
+		return clientErr, r
+	case <-time.After(10 * time.Second):
+		t.Fatal("the upstream server never finished with its connection")
+		return nil, upstreamResult{}
+	}
+}
+
+func TestSplitHelloForDeniedNameIsRefused(t *testing.T) {
+	clientErr, up := handshakeThroughGate(t, "gist.github.com")
+	if up.serverName != "" || up.err == nil {
+		t.Errorf("upstream saw a hello for %q (handshake err %v); a denied name must never reach it",
+			up.serverName, up.err)
+	}
+	if clientErr == nil {
+		t.Error("the client completed a handshake with a denied name")
+	}
+}
+
+// The positive control: the same split for an allowed name must still reach
+// the server and complete, or the refusal above proves nothing.
+func TestSplitHelloForAllowedNameConnects(t *testing.T) {
+	clientErr, up := handshakeThroughGate(t, "api.github.com")
+	if clientErr != nil {
+		t.Errorf("client handshake: %v", clientErr)
+	}
+	if up.err != nil || up.serverName != "api.github.com" {
+		t.Errorf("upstream saw %q with err %v, want a completed handshake for api.github.com",
+			up.serverName, up.err)
+	}
+}
+
+// A guest that sends the first part of a hello and then stops has not said
+// which name it wants. It must not be forwarded as though it were nameless.
+func TestTruncatedHelloIsNotForwarded(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	received := make(chan []byte, 1)
+	go func() {
+		conn, err := ln.Accept()
+		if err != nil {
+			received <- nil
+			return
+		}
+		defer conn.Close()
+		conn.SetDeadline(time.Now().Add(10 * time.Second))
+		b, _ := io.ReadAll(conn)
+		received <- b
+	}()
+	upstream, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	guest, client := net.Pipe()
+	go inspectAndForward(guest, upstream, net.ParseIP("127.0.0.1"), 443, splitTestEngine(t), nil)
+
+	// Capture a real hello, send only its first record's worth after the
+	// split, then hang up.
+	var captured []byte
+	capture := &captureConn{onWrite: func(b []byte) { captured = append(captured, b...) }}
+	conn := tls.Client(&splitFirstRecord{Conn: capture}, &tls.Config{ServerName: "gist.github.com"})
+	conn.SetDeadline(time.Now().Add(time.Second))
+	_ = conn.Handshake()
+	firstRecord := 5 + (int(captured[3])<<8 | int(captured[4]))
+
+	client.SetDeadline(time.Now().Add(10 * time.Second))
+	if _, err := client.Write(captured[:firstRecord]); err != nil {
+		t.Fatal(err)
+	}
+	client.Close()
+
+	select {
+	case b := <-received:
+		if len(b) != 0 {
+			t.Errorf("upstream received %d bytes of a hello the gate never read a name from", len(b))
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("the gate neither forwarded nor released the upstream")
+	}
+}
+
+// Traffic that is not TLS at all still goes through: the dial check already
+// allowed the address, and there is no name to check.
+func TestNonTLSIsStillForwarded(t *testing.T) {
+	ln, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	received := make(chan []byte, 1)
+	go func() {
+		conn, err := ln.Accept()
+		if err != nil {
+			received <- nil
+			return
+		}
+		defer conn.Close()
+		conn.SetDeadline(time.Now().Add(10 * time.Second))
+		b, _ := io.ReadAll(conn)
+		received <- b
+	}()
+	upstream, err := net.Dial("tcp", ln.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	guest, client := net.Pipe()
+	go inspectAndForward(guest, upstream, net.ParseIP("127.0.0.1"), 443, splitTestEngine(t), nil)
+
+	request := "GET / HTTP/1.1\r\nHost: gist.github.com\r\n\r\n"
+	client.SetDeadline(time.Now().Add(10 * time.Second))
+	if _, err := client.Write([]byte(request)); err != nil {
+		t.Fatal(err)
+	}
+	client.Close()
+
+	select {
+	case b := <-received:
+		if string(b) != request {
+			t.Errorf("upstream received %q, want the request replayed intact", b)
+		}
+	case <-time.After(10 * time.Second):
+		t.Fatal("upstream never saw the request")
+	}
+}
+
+// captureConn swallows what a TLS client writes and never answers, so the
+// client's first flight can be recorded without a peer.
+type captureConn struct {
+	net.Conn
+	onWrite func([]byte)
+}
+
+func (c *captureConn) Write(b []byte) (int, error)      { c.onWrite(b); return len(b), nil }
+func (c *captureConn) Read([]byte) (int, error)         { time.Sleep(10 * time.Millisecond); return 0, io.EOF }
+func (c *captureConn) Close() error                     { return nil }
+func (c *captureConn) SetDeadline(time.Time) error      { return nil }
+func (c *captureConn) SetReadDeadline(time.Time) error  { return nil }
+func (c *captureConn) SetWriteDeadline(time.Time) error { return nil }
