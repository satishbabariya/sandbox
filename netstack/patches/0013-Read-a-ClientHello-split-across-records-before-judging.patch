+// A hello within maxHello, sliced into one-byte records, would take far more
+// than maxPeek to carry. The reader must give up at the bound, not buffer it.
+func TestFineSplittingIsBounded(t *testing.T) {
+	var stream []byte
+	// A ClientHello header claiming just under maxHello bytes, then one byte
+	// per record for as long as the reader keeps asking.
+	for _, b := range []byte{0x01, 0x00, 0x3f, 0xf0} {
+		stream = append(stream, 0x16, 0x03, 0x01, 0x00, 0x01, b)
+	}
+	for len(stream) < 4*maxPeek {
+		stream = append(stream, 0x16, 0x03, 0x01, 0x00, 0x01, 0x00)
+	}
+	_, consumed, err := PeekServerName(bytes.NewReader(stream))
+	if !errors.Is(err, ErrMalformed) {
+		t.Errorf("err = %v, want ErrMalformed", err)
+	}
+	if len(consumed) > maxPeek {
+		t.Errorf("read %d bytes, more than the %d bound", len(consumed), maxPeek)
+	}
