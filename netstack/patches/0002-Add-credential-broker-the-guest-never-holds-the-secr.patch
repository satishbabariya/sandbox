diff --git a/pkg/broker/broker.go b/pkg/broker/broker.go
new file mode 100644
index 0000000..d70d7a7
--- /dev/null
+++ b/pkg/broker/broker.go
@@ -0,0 +1,191 @@
+package broker
+
+import (
+	"bufio"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"strings"
+	"sync"
+)
+
+// Credential binds one secret to one domain and header.
+type Credential struct {
+	Domain string `json:"domain"`
+	Header string `json:"header"`
+	Value  string `json:"value"`
+}
+
+type config struct {
+	Credentials []Credential `json:"credentials"`
+}
+
+// Broker holds the resolved credentials and the CA used to intercept the
+// domains they are bound to.
+type Broker struct {
+	ca *CA
+
+	mu    sync.RWMutex
+	creds map[string]Credential // lowercased domain -> credential
+}
+
+// Load reads the resolved-credential file the supervisor wrote.
+//
+// The file lives on the host in a directory never shared into the VM, so the
+// guest has no path to it. An empty path yields a broker that intercepts
+// nothing.
+func Load(path string) (*Broker, error) {
+	if path == "" {
+		return nil, nil
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		if os.IsNotExist(err) {
+			return nil, nil
+		}
+		return nil, fmt.Errorf("read broker config: %w", err)
+	}
+	var cfg config
+	if err := json.Unmarshal(data, &cfg); err != nil {
+		return nil, fmt.Errorf("parse broker config: %w", err)
+	}
+	if len(cfg.Credentials) == 0 {
+		return nil, nil
+	}
+	ca, err := NewCA()
+	if err != nil {
+		return nil, err
+	}
+	b := &Broker{ca: ca, creds: make(map[string]Credential, len(cfg.Credentials))}
+	for _, c := range cfg.Credentials {
+		b.creds[strings.ToLower(c.Domain)] = c
+	}
+	return b, nil
+}
+
+func (b *Broker) CA() *CA { return b.ca }
+
+// Intercepts reports whether requests to host carry an injected credential.
+// Anything else is passed through untouched, so the broker never sees plaintext
+// it has no business seeing.
+func (b *Broker) Intercepts(host string) bool {
+	if b == nil {
+		return false
+	}
+	b.mu.RLock()
+	defer b.mu.RUnlock()
+	_, ok := b.creds[strings.ToLower(stripPort(host))]
+	return ok
+}
+
+func stripPort(host string) string {
+	if h, _, err := net.SplitHostPort(host); err == nil {
+		return h
+	}
+	return host
+}
+
+// Handle terminates TLS from the guest, injects the credential, and
+// re-originates upstream.
+//
+// guest is the already-accepted connection; host is the SNI/destination name;
+// dial opens the upstream connection (which is where egress policy has already
+// been applied).
+func (b *Broker) Handle(guest net.Conn, host string, dial func() (net.Conn, error)) error {
+	return b.handleWithRoots(guest, host, dial, nil)
+}
+
+// handleWithRoots is Handle with an explicit upstream root pool. nil means the
+// system roots, which is what production uses; tests supply their own so they
+// can stand up a fake upstream without weakening verification.
+func (b *Broker) handleWithRoots(
+	guest net.Conn, host string, dial func() (net.Conn, error), roots *x509.CertPool,
+) error {
+	defer guest.Close()
+
+	name := stripPort(host)
+	leaf, err := b.ca.LeafFor(name)
+	if err != nil {
+		return err
+	}
+
+	tlsGuest := tls.Server(guest, &tls.Config{
+		Certificates: []tls.Certificate{*leaf},
+		MinVersion:   tls.VersionTLS12,
+	})
+	if err := tlsGuest.Handshake(); err != nil {
+		return fmt.Errorf("tls handshake with guest: %w", err)
+	}
+	defer tlsGuest.Close()
+
+	upstream, err := dial()
+	if err != nil {
+		return fmt.Errorf("dial upstream: %w", err)
+	}
+	defer upstream.Close()
+
+	// Verify upstream properly. Intercepting the guest must not mean we stop
+	// checking the server's identity ourselves.
+	tlsUpstream := tls.Client(upstream, &tls.Config{
+		ServerName: name,
+		RootCAs:    roots,
+		MinVersion: tls.VersionTLS12,
+	})
+	if err := tlsUpstream.Handshake(); err != nil {
+		return fmt.Errorf("tls handshake with upstream: %w", err)
+	}
+	defer tlsUpstream.Close()
+
+	b.mu.RLock()
+	cred := b.creds[strings.ToLower(name)]
+	b.mu.RUnlock()
+
+	guestReader := newReader(tlsGuest)
+	upstreamReader := newReader(tlsUpstream)
+
+	for {
+		req, err := http.ReadRequest(guestReader)
+		if err != nil {
+			if err == io.EOF {
+				return nil
+			}
+			return nil // guest hung up mid-request; nothing to report
+		}
+
+		// The substitution. The guest's sentinel never reaches the wire.
+		req.Header.Set(cred.Header, cred.Value)
+		req.URL.Scheme = "https"
+		req.URL.Host = name
+		// http.ReadRequest gives a server-side request; Write needs a
+		// client-side one.
+		req.RequestURI = ""
+
+		if err := req.Write(tlsUpstream); err != nil {
+			return fmt.Errorf("forward request: %w", err)
+		}
+
+		resp, err := http.ReadResponse(upstreamReader, req)
+		if err != nil {
+			return fmt.Errorf("read upstream response: %w", err)
+		}
+		if err := resp.Write(tlsGuest); err != nil {
+			resp.Body.Close()
+			return fmt.Errorf("return response: %w", err)
+		}
+		resp.Body.Close()
+
+		if req.Close || resp.Close {
+			return nil
+		}
+	}
+}
+
+// newReader wraps a connection for HTTP parsing.
+func newReader(c io.Reader) *bufio.Reader {
+	return bufio.NewReader(c)
+}
diff --git a/pkg/broker/broker_test.go b/pkg/broker/broker_test.go
new file mode 100644
index 0000000..030352b
--- /dev/null
+++ b/pkg/broker/broker_test.go
@@ -0,0 +1,204 @@
+package broker
+
+import (
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/json"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func writeConfig(t *testing.T, creds []Credential) string {
+	t.Helper()
+	path := filepath.Join(t.TempDir(), "broker.json")
+	data, err := json.Marshal(config{Credentials: creds})
+	if err != nil {
+		t.Fatalf("marshal: %v", err)
+	}
+	if err := os.WriteFile(path, data, 0o600); err != nil {
+		t.Fatalf("write: %v", err)
+	}
+	return path
+}
+
+func TestLoadReturnsNilWhenNothingIsBound(t *testing.T) {
+	// No config means no interception at all — the broker must not become a
+	// man in the middle for traffic it has no credential for.
+	if b, err := Load(""); err != nil || b != nil {
+		t.Fatalf("empty path: got (%v, %v), want (nil, nil)", b, err)
+	}
+	if b, err := Load(filepath.Join(t.TempDir(), "absent.json")); err != nil || b != nil {
+		t.Fatalf("missing file: got (%v, %v), want (nil, nil)", b, err)
+	}
+	if b, err := Load(writeConfig(t, nil)); err != nil || b != nil {
+		t.Fatalf("no credentials: got (%v, %v), want (nil, nil)", b, err)
+	}
+}
+
+func TestInterceptsOnlyBoundDomains(t *testing.T) {
+	b, err := Load(writeConfig(t, []Credential{
+		{Domain: "api.anthropic.com", Header: "x-api-key", Value: "sk-real"},
+	}))
+	if err != nil || b == nil {
+		t.Fatalf("Load: %v", err)
+	}
+
+	if !b.Intercepts("api.anthropic.com") {
+		t.Error("bound domain should be intercepted")
+	}
+	if !b.Intercepts("api.anthropic.com:443") {
+		t.Error("port should not defeat the match")
+	}
+	if !b.Intercepts("API.ANTHROPIC.COM") {
+		t.Error("match should be case-insensitive")
+	}
+	// Everything else stays end-to-end encrypted between guest and server.
+	if b.Intercepts("example.com") {
+		t.Error("unbound domain must not be intercepted")
+	}
+	if b.Intercepts("evil-api.anthropic.com.attacker.net") {
+		t.Error("suffix confusion must not match")
+	}
+}
+
+func TestCALeafIsSignedByCAAndNamesTheHost(t *testing.T) {
+	ca, err := NewCA()
+	if err != nil {
+		t.Fatalf("NewCA: %v", err)
+	}
+	leaf, err := ca.LeafFor("api.anthropic.com")
+	if err != nil {
+		t.Fatalf("LeafFor: %v", err)
+	}
+
+	parsed, err := x509.ParseCertificate(leaf.Certificate[0])
+	if err != nil {
+		t.Fatalf("parse leaf: %v", err)
+	}
+
+	pool := x509.NewCertPool()
+	if !pool.AppendCertsFromPEM(ca.CertPEM()) {
+		t.Fatal("CA PEM did not parse")
+	}
+	if _, err := parsed.Verify(x509.VerifyOptions{
+		DNSName: "api.anthropic.com",
+		Roots:   pool,
+	}); err != nil {
+		t.Errorf("leaf should verify against the CA: %v", err)
+	}
+
+	// A guest that trusts our CA must not thereby trust a name we never issued.
+	if _, err := parsed.Verify(x509.VerifyOptions{
+		DNSName: "evil.com",
+		Roots:   pool,
+	}); err == nil {
+		t.Error("leaf must not validate for an unrelated host")
+	}
+}
+
+func TestLeafCertificatesAreCached(t *testing.T) {
+	ca, err := NewCA()
+	if err != nil {
+		t.Fatalf("NewCA: %v", err)
+	}
+	first, _ := ca.LeafFor("api.anthropic.com")
+	second, _ := ca.LeafFor("api.anthropic.com")
+	if first != second {
+		t.Error("repeated requests should reuse the cached leaf")
+	}
+}
+
+// The behaviour that matters: the guest sends a sentinel, the upstream server
+// sees the real secret, and the sentinel never reaches the wire.
+func TestSentinelIsReplacedBeforeItLeavesTheHost(t *testing.T) {
+	const sentinel = "airlock-managed"
+	const real = "sk-the-real-secret"
+
+	var seenAuth string
+	var seenCount int
+	upstream := &http.Server{}
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatalf("listen: %v", err)
+	}
+	defer listener.Close()
+
+	// A TLS server standing in for the real API.
+	serverCA, err := NewCA()
+	if err != nil {
+		t.Fatalf("server CA: %v", err)
+	}
+	serverLeaf, err := serverCA.LeafFor("127.0.0.1")
+	if err != nil {
+		t.Fatalf("server leaf: %v", err)
+	}
+	tlsListener := tls.NewListener(listener, &tls.Config{
+		Certificates: []tls.Certificate{*serverLeaf},
+	})
+	upstream.Handler = http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		seenAuth = r.Header.Get("x-api-key")
+		seenCount++
+		w.WriteHeader(http.StatusOK)
+		io.WriteString(w, "ok")
+	})
+	go upstream.Serve(tlsListener)
+	defer upstream.Close()
+
+	host := listener.Addr().String()
+	b, err := Load(writeConfig(t, []Credential{
+		{Domain: "127.0.0.1", Header: "x-api-key", Value: real},
+	}))
+	if err != nil || b == nil {
+		t.Fatalf("Load: %v", err)
+	}
+
+	guestSide, brokerSide := net.Pipe()
+
+	serverPool := x509.NewCertPool()
+	serverPool.AppendCertsFromPEM(serverCA.CertPEM())
+
+	done := make(chan error, 1)
+	go func() {
+		done <- b.handleWithRoots(brokerSide, host, func() (net.Conn, error) {
+			return net.Dial("tcp", host)
+		}, serverPool)
+	}()
+
+	// The guest trusts airlock's CA, as it would inside the sandbox.
+	guestPool := x509.NewCertPool()
+	if !guestPool.AppendCertsFromPEM(b.CA().CertPEM()) {
+		t.Fatal("guest could not parse airlock CA")
+	}
+	client := tls.Client(guestSide, &tls.Config{
+		ServerName: "127.0.0.1",
+		RootCAs:    guestPool,
+	})
+	req, _ := http.NewRequest("GET", "https://127.0.0.1/v1/messages", nil)
+	req.Header.Set("x-api-key", sentinel)
+	req.Host = "127.0.0.1"
+	if err := req.Write(client); err != nil {
+		t.Fatalf("guest write: %v", err)
+	}
+	resp, err := http.ReadResponse(newReader(client), req)
+	if err != nil {
+		t.Fatalf("guest read: %v", err)
+	}
+	resp.Body.Close()
+	client.Close()
+	guestSide.Close()
+	<-done
+
+	if seenCount == 0 {
+		t.Fatal("upstream never received the request")
+	}
+	if seenAuth == sentinel {
+		t.Error("the sentinel reached the upstream server; substitution did not happen")
+	}
+	if seenAuth != real {
+		t.Errorf("upstream saw %q, want the real secret", seenAuth)
+	}
+}
diff --git a/pkg/broker/ca.go b/pkg/broker/ca.go
new file mode 100644
index 0000000..92a6455
--- /dev/null
+++ b/pkg/broker/ca.go
@@ -0,0 +1,141 @@
+// Package broker injects credentials into outbound requests without the guest
+// ever holding them.
+//
+// The guest sends a sentinel value. This runs on the host, terminates TLS for
+// the specific domains a credential is bound to, replaces the sentinel header
+// with the real secret, and re-originates the connection upstream. A sentinel
+// copied out of the sandbox is worthless: the substitution only happens here,
+// and only for the bound domain.
+package broker
+
+import (
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"crypto/x509/pkix"
+	"encoding/pem"
+	"fmt"
+	"math/big"
+	"net"
+	"os"
+	"sync"
+	"time"
+)
+
+// CA mints leaf certificates on demand for the domains being intercepted.
+//
+// A fresh CA is generated per sandbox rather than shared. Its private key never
+// leaves the host, and only the public certificate is placed in the guest's
+// trust store, so possessing it lets the guest verify our leaf certs and
+// nothing else.
+type CA struct {
+	cert    *x509.Certificate
+	key     *ecdsa.PrivateKey
+	certPEM []byte
+
+	mu     sync.Mutex
+	issued map[string]*tls.Certificate
+}
+
+func NewCA() (*CA, error) {
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		return nil, fmt.Errorf("generate CA key: %w", err)
+	}
+	serial, err := randomSerial()
+	if err != nil {
+		return nil, err
+	}
+	template := &x509.Certificate{
+		SerialNumber: serial,
+		Subject: pkix.Name{
+			CommonName:   "airlock sandbox CA",
+			Organization: []string{"airlock"},
+		},
+		NotBefore: time.Now().Add(-time.Hour),
+		// Sandboxes are short-lived; a short-lived CA limits the blast radius
+		// if the guest ever did extract the public cert and get it trusted
+		// somewhere it should not be.
+		NotAfter:              time.Now().AddDate(0, 0, 30),
+		KeyUsage:              x509.KeyUsageCertSign | x509.KeyUsageDigitalSignature,
+		BasicConstraintsValid: true,
+		IsCA:                  true,
+		MaxPathLen:            0,
+	}
+	der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+	if err != nil {
+		return nil, fmt.Errorf("create CA cert: %w", err)
+	}
+	cert, err := x509.ParseCertificate(der)
+	if err != nil {
+		return nil, err
+	}
+	return &CA{
+		cert:    cert,
+		key:     key,
+		certPEM: pem.EncodeToMemory(&pem.Block{Type: "CERTIFICATE", Bytes: der}),
+		issued:  make(map[string]*tls.Certificate),
+	}, nil
+}
+
+// CertPEM is the public certificate to install in the guest's trust store.
+func (c *CA) CertPEM() []byte { return c.certPEM }
+
+// WriteCertPEM writes the public certificate for the supervisor to hand to the
+// guest. Only the certificate — never the key.
+func (c *CA) WriteCertPEM(path string) error {
+	return os.WriteFile(path, c.certPEM, 0o644)
+}
+
+// LeafFor returns a certificate for host, minting and caching one if needed.
+func (c *CA) LeafFor(host string) (*tls.Certificate, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if cached, ok := c.issued[host]; ok {
+		return cached, nil
+	}
+
+	key, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		return nil, err
+	}
+	serial, err := randomSerial()
+	if err != nil {
+		return nil, err
+	}
+	template := &x509.Certificate{
+		SerialNumber: serial,
+		Subject:      pkix.Name{CommonName: host},
+		NotBefore:    time.Now().Add(-time.Hour),
+		NotAfter:     time.Now().AddDate(0, 0, 30),
+		KeyUsage:     x509.KeyUsageDigitalSignature | x509.KeyUsageKeyEncipherment,
+		ExtKeyUsage:  []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
+	}
+	if ip := net.ParseIP(host); ip != nil {
+		template.IPAddresses = []net.IP{ip}
+	} else {
+		template.DNSNames = []string{host}
+	}
+
+	der, err := x509.CreateCertificate(rand.Reader, template, c.cert, &key.PublicKey, c.key)
+	if err != nil {
+		return nil, fmt.Errorf("sign leaf for %s: %w", host, err)
+	}
+	leaf := &tls.Certificate{
+		Certificate: [][]byte{der, c.cert.Raw},
+		PrivateKey:  key,
+	}
+	c.issued[host] = leaf
+	return leaf, nil
+}
+
+func randomSerial() (*big.Int, error) {
+	limit := new(big.Int).Lsh(big.NewInt(1), 128)
+	serial, err := rand.Int(rand.Reader, limit)
+	if err != nil {
+		return nil, fmt.Errorf("serial: %w", err)
+	}
+	return serial, nil
+}
