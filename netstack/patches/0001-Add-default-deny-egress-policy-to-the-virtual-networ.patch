diff --git a/pkg/policy/engine.go b/pkg/policy/engine.go
new file mode 100644
index 0000000..ebad9a5
--- /dev/null
+++ b/pkg/policy/engine.go
@@ -0,0 +1,285 @@
+package policy
+
+import (
+	"encoding/json"
+	"fmt"
+	"net"
+	"os"
+	"sync"
+	"time"
+)
+
+// Verdict is the outcome of a policy evaluation.
+type Verdict struct {
+	Allowed bool
+	// Rule is the pattern that decided it, empty when nothing matched.
+	Rule string
+	// Reason is a short machine-readable cause, for the audit log.
+	Reason string
+	// Names are the hostnames we had previously resolved to this address.
+	Names []string
+}
+
+const (
+	ReasonAllowRule    = "allow-rule"
+	ReasonDenyRule     = "deny-rule"
+	ReasonNoAllowRule  = "no-allow-rule"
+	ReasonUnresolvedIP = "unresolved-address"
+)
+
+// Engine is the authoritative egress policy for one sandbox.
+//
+// It answers two different questions, and the pair is what gives the guarantee:
+//
+//   - AllowName gates DNS. A name outside policy is never resolved, so the
+//     guest never learns its address.
+//   - AllowDial gates the outbound socket. It permits an address only if that
+//     address was handed out by our own resolver for a name policy allows, or
+//     is itself allow-listed literally.
+//
+// Because the guest has no other resolver and no other route, an address we
+// never answered is an address the guest should not have — so hardcoding an IP
+// to skip DNS fails closed rather than bypassing the check.
+type Engine struct {
+	mu     sync.RWMutex
+	allow  []Pattern
+	deny   []Pattern
+	ledger map[string]*ledgerEntry
+
+	auditMu sync.Mutex
+	audit   *os.File
+
+	now func() time.Time
+}
+
+type ledgerEntry struct {
+	names   map[string]time.Time // name -> expiry
+	lastUse time.Time
+}
+
+// minLedgerTTL keeps a resolved address usable for a sensible minimum even when
+// upstream hands back a very short TTL. Connections are made shortly after the
+// lookup, and a 5s TTL would otherwise race the dial.
+const minLedgerTTL = 5 * time.Minute
+
+// maxLedgerEntries bounds memory against a guest that resolves endlessly.
+const maxLedgerEntries = 8192
+
+func NewEngine(allow, deny []string, auditPath string) (*Engine, error) {
+	e := &Engine{
+		ledger: make(map[string]*ledgerEntry),
+		now:    time.Now,
+	}
+	for _, raw := range allow {
+		p, err := ParsePattern(raw)
+		if err != nil {
+			return nil, err
+		}
+		e.allow = append(e.allow, p)
+	}
+	for _, raw := range deny {
+		p, err := ParsePattern(raw)
+		if err != nil {
+			return nil, err
+		}
+		e.deny = append(e.deny, p)
+	}
+	if auditPath != "" {
+		f, err := os.OpenFile(auditPath, os.O_CREATE|os.O_WRONLY|os.O_APPEND, 0o600)
+		if err != nil {
+			return nil, fmt.Errorf("cannot open policy audit log: %w", err)
+		}
+		e.audit = f
+	}
+	return e, nil
+}
+
+func (e *Engine) Close() error {
+	e.auditMu.Lock()
+	defer e.auditMu.Unlock()
+	if e.audit != nil {
+		err := e.audit.Close()
+		e.audit = nil
+		return err
+	}
+	return nil
+}
+
+// evaluate applies deny-then-allow to a hostname. Deny always wins; anything
+// matching neither list is denied.
+func (e *Engine) evaluate(host string, port uint16) Verdict {
+	for _, p := range e.deny {
+		if p.Matches(host, port) {
+			return Verdict{Allowed: false, Rule: p.Raw, Reason: ReasonDenyRule}
+		}
+	}
+	for _, p := range e.allow {
+		if p.Matches(host, port) {
+			return Verdict{Allowed: true, Rule: p.Raw, Reason: ReasonAllowRule}
+		}
+	}
+	return Verdict{Allowed: false, Reason: ReasonNoAllowRule}
+}
+
+// AllowName gates a DNS query. Port is unknown at resolution time, so a
+// port-qualified rule is treated as covering the name; the real enforcement for
+// that rule happens again at dial time in AllowDial.
+func (e *Engine) AllowName(name string) Verdict {
+	e.mu.RLock()
+	defer e.mu.RUnlock()
+
+	host := normalizeHost(name)
+	for _, p := range e.deny {
+		if p.Port == 0 && p.Matches(host, 0) {
+			return Verdict{Allowed: false, Rule: p.Raw, Reason: ReasonDenyRule}
+		}
+	}
+	for _, p := range e.allow {
+		// Ignore the port when deciding whether to resolve at all.
+		bare := Pattern{Host: p.Host, Wildcard: p.Wildcard, Raw: p.Raw}
+		if bare.Matches(host, 0) {
+			return Verdict{Allowed: true, Rule: p.Raw, Reason: ReasonAllowRule}
+		}
+	}
+	return Verdict{Allowed: false, Reason: ReasonNoAllowRule}
+}
+
+// NoteResolution records that we answered `name` with `ips`. Only call this for
+// answers actually returned to the guest.
+func (e *Engine) NoteResolution(name string, ips []net.IP, ttl time.Duration) {
+	if ttl < minLedgerTTL {
+		ttl = minLedgerTTL
+	}
+	host := normalizeHost(name)
+	now := e.now()
+	expiry := now.Add(ttl)
+
+	e.mu.Lock()
+	defer e.mu.Unlock()
+
+	e.pruneLocked(now)
+	for _, ip := range ips {
+		key := ip.String()
+		entry, ok := e.ledger[key]
+		if !ok {
+			if len(e.ledger) >= maxLedgerEntries {
+				// Full and nothing expired: refuse to grow. Failing to record
+				// means the dial is denied, which is the safe direction.
+				continue
+			}
+			entry = &ledgerEntry{names: make(map[string]time.Time)}
+			e.ledger[key] = entry
+		}
+		if cur, ok := entry.names[host]; !ok || expiry.After(cur) {
+			entry.names[host] = expiry
+		}
+		entry.lastUse = now
+	}
+}
+
+func (e *Engine) pruneLocked(now time.Time) {
+	for key, entry := range e.ledger {
+		for name, expiry := range entry.names {
+			if now.After(expiry) {
+				delete(entry.names, name)
+			}
+		}
+		if len(entry.names) == 0 {
+			delete(e.ledger, key)
+		}
+	}
+}
+
+// AllowDial gates an outbound connection to a literal address.
+func (e *Engine) AllowDial(proto string, ip net.IP, port uint16) Verdict {
+	v := e.allowDial(ip, port)
+	e.record(proto, ip, port, v)
+	return v
+}
+
+func (e *Engine) allowDial(ip net.IP, port uint16) Verdict {
+	e.mu.Lock()
+	now := e.now()
+	e.pruneLocked(now)
+	entry := e.ledger[ip.String()]
+	var names []string
+	if entry != nil {
+		for name := range entry.names {
+			names = append(names, name)
+		}
+		entry.lastUse = now
+	}
+	e.mu.Unlock()
+
+	e.mu.RLock()
+	defer e.mu.RUnlock()
+
+	// A name we resolved for this address, still within policy at this port.
+	// Deny is checked across every associated name before any allow, so a
+	// denied name cannot be laundered through a second name on a shared IP.
+	for _, name := range names {
+		for _, p := range e.deny {
+			if p.Matches(name, port) {
+				return Verdict{Allowed: false, Rule: p.Raw, Reason: ReasonDenyRule, Names: names}
+			}
+		}
+	}
+	for _, name := range names {
+		for _, p := range e.allow {
+			if p.Matches(name, port) {
+				return Verdict{Allowed: true, Rule: p.Raw, Reason: ReasonAllowRule, Names: names}
+			}
+		}
+	}
+
+	// A literal address in the rules, for pinning a host with no DNS name.
+	literal := ip.String()
+	for _, p := range e.deny {
+		if p.Matches(literal, port) {
+			return Verdict{Allowed: false, Rule: p.Raw, Reason: ReasonDenyRule, Names: names}
+		}
+	}
+	for _, p := range e.allow {
+		if p.Matches(literal, port) {
+			return Verdict{Allowed: true, Rule: p.Raw, Reason: ReasonAllowRule, Names: names}
+		}
+	}
+
+	if len(names) == 0 {
+		// The hardcoded-IP case: an address our resolver never handed out.
+		return Verdict{Allowed: false, Reason: ReasonUnresolvedIP}
+	}
+	return Verdict{Allowed: false, Reason: ReasonNoAllowRule, Names: names}
+}
+
+type auditRecord struct {
+	Time    string   `json:"time"`
+	Proto   string   `json:"proto"`
+	Address string   `json:"address"`
+	Port    uint16   `json:"port"`
+	Allowed bool     `json:"allowed"`
+	Rule    string   `json:"rule,omitempty"`
+	Reason  string   `json:"reason"`
+	Names   []string `json:"names,omitempty"`
+}
+
+func (e *Engine) record(proto string, ip net.IP, port uint16, v Verdict) {
+	e.auditMu.Lock()
+	defer e.auditMu.Unlock()
+	if e.audit == nil {
+		return
+	}
+	rec := auditRecord{
+		Time:    e.now().UTC().Format(time.RFC3339Nano),
+		Proto:   proto,
+		Address: ip.String(),
+		Port:    port,
+		Allowed: v.Allowed,
+		Rule:    v.Rule,
+		Reason:  v.Reason,
+		Names:   v.Names,
+	}
+	if b, err := json.Marshal(rec); err == nil {
+		_, _ = e.audit.Write(append(b, '\n'))
+	}
+}
diff --git a/pkg/policy/pattern.go b/pkg/policy/pattern.go
new file mode 100644
index 0000000..81c2ad4
--- /dev/null
+++ b/pkg/policy/pattern.go
@@ -0,0 +1,120 @@
+// Package policy implements airlock's default-deny egress policy for the
+// virtual network stack.
+//
+// This is the authoritative enforcement point. The guest has exactly one
+// network device, whose wire is a datagram socket held by the host, so every
+// frame the guest emits arrives here regardless of what the guest believes
+// about its own routes, firewall, or proxy environment.
+package policy
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// Pattern is one entry in an allow- or deny-list.
+//
+// Three shapes are accepted: an exact host (api.anthropic.com), an exact host
+// with a port (registry.example.com:5000), and a leading-label wildcard
+// (*.githubusercontent.com).
+//
+// The matching semantics here MUST agree exactly with the Swift implementation
+// in AirlockKit. Both are exercised against testdata/host-patterns.json.
+type Pattern struct {
+	// Host is lowercased. For a wildcard it is the suffix with the leading
+	// "*." removed, so "*.example.com" stores "example.com".
+	Host     string
+	Port     uint16 // 0 means "any port"
+	Wildcard bool
+	Raw      string
+}
+
+func ParsePattern(raw string) (Pattern, error) {
+	trimmed := strings.TrimSpace(raw)
+	if trimmed == "" {
+		return Pattern{}, fmt.Errorf("host pattern must not be empty")
+	}
+
+	bad := func(reason string) error {
+		return fmt.Errorf("invalid host pattern %q: %s", raw, reason)
+	}
+
+	if strings.Contains(trimmed, "/") {
+		return Pattern{}, bad("expected a bare host, not a URL or path")
+	}
+
+	hostPart := trimmed
+	var port uint16
+
+	if i := strings.LastIndex(trimmed, ":"); i >= 0 && !strings.HasPrefix(trimmed, "[") {
+		if strings.Count(trimmed, ":") > 1 {
+			return Pattern{}, bad("bracket IPv6 literals as [::1]")
+		}
+		before, after := trimmed[:i], trimmed[i+1:]
+		n, err := strconv.ParseUint(after, 10, 16)
+		if err != nil || n == 0 {
+			return Pattern{}, bad("port must be an integer in 1...65535")
+		}
+		if before == "" {
+			return Pattern{}, bad("missing host before port")
+		}
+		hostPart, port = before, uint16(n)
+	}
+
+	wildcard := false
+	if strings.HasPrefix(hostPart, "*") {
+		if !strings.HasPrefix(hostPart, "*.") {
+			return Pattern{}, bad("a wildcard must be a whole label, as in *.example.com")
+		}
+		hostPart = hostPart[2:]
+		wildcard = true
+		if hostPart == "" {
+			return Pattern{}, bad("a wildcard needs a suffix, as in *.example.com")
+		}
+	}
+
+	if strings.Contains(hostPart, "*") {
+		return Pattern{}, bad("a wildcard is only allowed in the leading label")
+	}
+	if hostPart == "" {
+		return Pattern{}, bad("missing host")
+	}
+
+	return Pattern{
+		Host:     normalizeHost(hostPart),
+		Port:     port,
+		Wildcard: wildcard,
+		Raw:      trimmed,
+	}, nil
+}
+
+// normalizeHost lowercases and strips a trailing root label, so "EXAMPLE.com."
+// and "example.com" compare equal.
+func normalizeHost(h string) string {
+	h = strings.ToLower(h)
+	for strings.HasSuffix(h, ".") {
+		h = h[:len(h)-1]
+	}
+	return h
+}
+
+// Matches reports whether the pattern covers host:port. A port of 0 on the
+// query means "unspecified"; a pattern that pins a port will not match it.
+func (p Pattern) Matches(host string, port uint16) bool {
+	if p.Port != 0 && p.Port != port {
+		return false
+	}
+	candidate := normalizeHost(host)
+	if candidate == "" {
+		return false
+	}
+	if p.Wildcard {
+		// Apex, or a suffix on a label boundary. The "." is what stops
+		// "*.example.com" matching "evilexample.com".
+		return candidate == p.Host || strings.HasSuffix(candidate, "."+p.Host)
+	}
+	return candidate == p.Host
+}
+
+func (p Pattern) String() string { return p.Raw }
diff --git a/pkg/policy/policy_test.go b/pkg/policy/policy_test.go
new file mode 100644
index 0000000..8441275
--- /dev/null
+++ b/pkg/policy/policy_test.go
@@ -0,0 +1,237 @@
+package policy
+
+import (
+	"encoding/json"
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+type vectors struct {
+	Invalid []string `json:"invalid"`
+	Matches []struct {
+		Pattern string `json:"pattern"`
+		Host    string `json:"host"`
+		Port    uint16 `json:"port"`
+		Expect  bool   `json:"expect"`
+	} `json:"matches"`
+	Policies []struct {
+		Name  string   `json:"name"`
+		Allow []string `json:"allow"`
+		Deny  []string `json:"deny"`
+		Cases []struct {
+			Host    string `json:"host"`
+			Port    uint16 `json:"port"`
+			Allowed bool   `json:"allowed"`
+		} `json:"cases"`
+	} `json:"policies"`
+}
+
+func loadVectors(t *testing.T) vectors {
+	t.Helper()
+	b, err := os.ReadFile(filepath.Join("testdata", "host-patterns.json"))
+	if err != nil {
+		t.Fatalf("read vectors: %v", err)
+	}
+	var v vectors
+	if err := json.Unmarshal(b, &v); err != nil {
+		t.Fatalf("parse vectors: %v", err)
+	}
+	return v
+}
+
+// TestSharedVectors is the conformance gate. AirlockKit's Swift matcher reads
+// the identical file; if these two ever disagree, `airlock policy check` lies
+// about what the enforcement point will actually do.
+func TestSharedVectors(t *testing.T) {
+	v := loadVectors(t)
+
+	for _, raw := range v.Invalid {
+		if _, err := ParsePattern(raw); err == nil {
+			t.Errorf("ParsePattern(%q) should have failed", raw)
+		}
+	}
+
+	for _, c := range v.Matches {
+		p, err := ParsePattern(c.Pattern)
+		if err != nil {
+			t.Fatalf("ParsePattern(%q): %v", c.Pattern, err)
+		}
+		if got := p.Matches(c.Host, c.Port); got != c.Expect {
+			t.Errorf("Pattern(%q).Matches(%q, %d) = %v, want %v",
+				c.Pattern, c.Host, c.Port, got, c.Expect)
+		}
+	}
+
+	for _, pol := range v.Policies {
+		e, err := NewEngine(pol.Allow, pol.Deny, "")
+		if err != nil {
+			t.Fatalf("%s: NewEngine: %v", pol.Name, err)
+		}
+		for _, c := range pol.Cases {
+			if got := e.evaluate(c.Host, c.Port).Allowed; got != c.Allowed {
+				t.Errorf("%s: evaluate(%q, %d) = %v, want %v",
+					pol.Name, c.Host, c.Port, got, c.Allowed)
+			}
+		}
+	}
+}
+
+func mustEngine(t *testing.T, allow, deny []string) *Engine {
+	t.Helper()
+	e, err := NewEngine(allow, deny, "")
+	if err != nil {
+		t.Fatalf("NewEngine: %v", err)
+	}
+	return e
+}
+
+// The central claim of the product: an address the resolver never handed out
+// cannot be dialled, so skipping DNS does not skip policy.
+func TestHardcodedIPIsRefused(t *testing.T) {
+	e := mustEngine(t, []string{"*.anthropic.com"}, nil)
+
+	v := e.AllowDial("tcp", net.ParseIP("13.37.13.37"), 443)
+	if v.Allowed {
+		t.Fatal("an address never resolved by us must not be dialable")
+	}
+	if v.Reason != ReasonUnresolvedIP {
+		t.Errorf("reason = %q, want %q", v.Reason, ReasonUnresolvedIP)
+	}
+}
+
+func TestResolvedAddressIsDialable(t *testing.T) {
+	e := mustEngine(t, []string{"*.anthropic.com"}, nil)
+	ip := net.ParseIP("160.79.104.10")
+
+	e.NoteResolution("api.anthropic.com", []net.IP{ip}, time.Minute)
+
+	if v := e.AllowDial("tcp", ip, 443); !v.Allowed {
+		t.Fatalf("resolved allowed name should be dialable, got %+v", v)
+	}
+}
+
+// A CDN address may serve several names. If any name on it is denied, the
+// address is denied — a denied name must not be laundered through a second
+// name that happens to share the IP.
+func TestDenyWinsAcrossSharedAddress(t *testing.T) {
+	e := mustEngine(t, []string{"*.github.com"}, []string{"gist.github.com"})
+	ip := net.ParseIP("140.82.113.4")
+
+	e.NoteResolution("api.github.com", []net.IP{ip}, time.Minute)
+	e.NoteResolution("gist.github.com", []net.IP{ip}, time.Minute)
+
+	v := e.AllowDial("tcp", ip, 443)
+	if v.Allowed {
+		t.Fatal("shared address carrying a denied name must be refused")
+	}
+	if v.Reason != ReasonDenyRule {
+		t.Errorf("reason = %q, want %q", v.Reason, ReasonDenyRule)
+	}
+}
+
+func TestDNSGateRefusesUnallowedName(t *testing.T) {
+	e := mustEngine(t, []string{"*.anthropic.com"}, nil)
+
+	if v := e.AllowName("exfil.evil.com"); v.Allowed {
+		t.Fatal("a name outside policy must not be resolved")
+	}
+	if v := e.AllowName("api.anthropic.com"); !v.Allowed {
+		t.Fatal("a name inside policy must resolve")
+	}
+}
+
+// A port-qualified allow still gates the name at resolution time, but the port
+// itself is only enforceable once we know it, at dial time.
+func TestPortQualifiedRuleEnforcedAtDial(t *testing.T) {
+	e := mustEngine(t, []string{"registry.example.com:5000"}, nil)
+	ip := net.ParseIP("10.11.12.13")
+
+	if v := e.AllowName("registry.example.com"); !v.Allowed {
+		t.Fatal("port-qualified rule should still permit resolution")
+	}
+	e.NoteResolution("registry.example.com", []net.IP{ip}, time.Minute)
+
+	if v := e.AllowDial("tcp", ip, 5000); !v.Allowed {
+		t.Errorf("port 5000 should be allowed, got %+v", v)
+	}
+	if v := e.AllowDial("tcp", ip, 443); v.Allowed {
+		t.Error("port 443 must be refused by a :5000 rule")
+	}
+}
+
+func TestLiteralAddressRuleWorksWithoutDNS(t *testing.T) {
+	e := mustEngine(t, []string{"10.0.0.5"}, nil)
+
+	if v := e.AllowDial("tcp", net.ParseIP("10.0.0.5"), 8080); !v.Allowed {
+		t.Fatalf("literal address rule should permit the dial, got %+v", v)
+	}
+	if v := e.AllowDial("tcp", net.ParseIP("10.0.0.6"), 8080); v.Allowed {
+		t.Fatal("a neighbouring address must not be permitted")
+	}
+}
+
+func TestLedgerEntriesExpire(t *testing.T) {
+	e := mustEngine(t, []string{"*.anthropic.com"}, nil)
+	base := time.Now()
+	e.now = func() time.Time { return base }
+
+	ip := net.ParseIP("160.79.104.10")
+	e.NoteResolution("api.anthropic.com", []net.IP{ip}, time.Minute)
+
+	if v := e.AllowDial("tcp", ip, 443); !v.Allowed {
+		t.Fatal("should be allowed while the entry is live")
+	}
+
+	// minLedgerTTL floors the recorded TTL, so step past that.
+	e.now = func() time.Time { return base.Add(minLedgerTTL + time.Minute) }
+	if v := e.AllowDial("tcp", ip, 443); v.Allowed {
+		t.Fatal("an expired ledger entry must stop authorising the address")
+	}
+}
+
+func TestEmptyPolicyDeniesEverything(t *testing.T) {
+	e := mustEngine(t, nil, nil)
+	ip := net.ParseIP("1.1.1.1")
+	e.NoteResolution("anything.com", []net.IP{ip}, time.Minute)
+
+	if v := e.AllowDial("tcp", ip, 443); v.Allowed {
+		t.Fatal("a policy with no rules must reach nothing")
+	}
+	if v := e.AllowName("anything.com"); v.Allowed {
+		t.Fatal("a policy with no rules must resolve nothing")
+	}
+}
+
+func TestAuditLogRecordsDecisions(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "policy.jsonl")
+	e, err := NewEngine([]string{"*.anthropic.com"}, nil, path)
+	if err != nil {
+		t.Fatalf("NewEngine: %v", err)
+	}
+	e.AllowDial("tcp", net.ParseIP("13.37.13.37"), 443)
+	if err := e.Close(); err != nil {
+		t.Fatalf("Close: %v", err)
+	}
+
+	b, err := os.ReadFile(path)
+	if err != nil {
+		t.Fatalf("read audit log: %v", err)
+	}
+	var rec auditRecord
+	if err := json.Unmarshal(b[:len(b)-1], &rec); err != nil {
+		t.Fatalf("parse audit record: %v", err)
+	}
+	if rec.Allowed || rec.Reason != ReasonUnresolvedIP || rec.Address != "13.37.13.37" {
+		t.Errorf("unexpected audit record: %+v", rec)
+	}
+}
+
+func TestInvalidPatternRejectedAtConstruction(t *testing.T) {
+	if _, err := NewEngine([]string{"*bad.com"}, nil, ""); err == nil {
+		t.Fatal("a malformed pattern must fail engine construction, not be ignored")
+	}
+}
