+++ b/pkg/services/dns/policy_test.go
@@ -0,0 +1,117 @@
+package dns
+
+import (
+	"context"
+	"net"
+	"testing"
+
+	"github.com/containers/gvisor-tap-vsock/pkg/policy"
+	"github.com/containers/gvisor-tap-vsock/pkg/types"
+	"github.com/miekg/dns"
+)
+
+// stubResolver answers every A lookup with one fixed address, so the tests
+// exercise the gate rather than the network.
+type stubResolver struct {
+	addr    net.IP
+	queried []string
+}
+
+func (s *stubResolver) LookupIPAddr(_ context.Context, host string) ([]net.IPAddr, error) {
+	s.queried = append(s.queried, host)
+	return []net.IPAddr{{IP: s.addr}}, nil
+}
+func (s *stubResolver) LookupCNAME(context.Context, string) (string, error) { return "", nil }
+func (s *stubResolver) LookupMX(context.Context, string) ([]*net.MX, error) { return nil, nil }
+func (s *stubResolver) LookupNS(context.Context, string) ([]*net.NS, error) { return nil, nil }
+func (s *stubResolver) LookupSRV(context.Context, string, string, string) (string, []*net.SRV, error) {
+	return "", nil, nil
+}
+func (s *stubResolver) LookupTXT(context.Context, string) ([]string, error) { return nil, nil }
+
+func newGatedHandler(t *testing.T, allow, deny []string, addr string) (*dnsHandler, *policy.Engine, *stubResolver) {
+	t.Helper()
+	eng, err := policy.NewEngine(allow, deny, "")
+	if err != nil {
+		t.Fatalf("NewEngine: %v", err)
+	}
+	res := &stubResolver{addr: net.ParseIP(addr)}
+	return &dnsHandler{zones: []types.Zone{}, upstream: res, policy: eng}, eng, res
+}
+
+func query(h *dnsHandler, name string) *dns.Msg {
+	m := new(dns.Msg)
+	m.Question = []dns.Question{{Name: name, Qtype: dns.TypeA, Qclass: dns.ClassINET}}
+	h.addAnswers(m)
+	return m
+}
+
+// A name outside policy must never reach the upstream resolver at all — that is
+// what stops the guest from learning an address it could then dial directly.
+func TestDeniedNameIsNeverResolved(t *testing.T) {
+	h, _, res := newGatedHandler(t, []string{"*.anthropic.com"}, nil, "10.0.0.1")
+
+	m := query(h, "exfil.evil.com.")
+
+	if m.Rcode != dns.RcodeRefused {
+		t.Errorf("Rcode = %v, want REFUSED", dns.RcodeToString[m.Rcode])
+	}
+	if len(m.Answer) != 0 {
+		t.Errorf("expected no answers, got %d", len(m.Answer))
+	}
+	if len(res.queried) != 0 {
+		t.Errorf("upstream must not be consulted for a denied name, got %v", res.queried)
+	}
+}
+
+func TestAllowedNameResolvesAndIsVouchedFor(t *testing.T) {
+	h, eng, res := newGatedHandler(t, []string{"*.anthropic.com"}, nil, "160.79.104.10")
+
+	m := query(h, "api.anthropic.com.")
+
+	if m.Rcode != dns.RcodeSuccess {
+		t.Fatalf("Rcode = %v, want SUCCESS", dns.RcodeToString[m.Rcode])
+	}
+	if len(m.Answer) != 1 {
+		t.Fatalf("expected 1 answer, got %d", len(m.Answer))
+	}
+	if len(res.queried) != 1 {
+		t.Fatalf("upstream should have been consulted once, got %v", res.queried)
+	}
+
+	// The address we just handed out must now be dialable; a neighbouring one
+	// must not be.
+	if v := eng.AllowDial("tcp", net.ParseIP("160.79.104.10"), 443); !v.Allowed {
+		t.Errorf("resolved address should be dialable, got %+v", v)
+	}
+	if v := eng.AllowDial("tcp", net.ParseIP("160.79.104.11"), 443); v.Allowed {
+		t.Error("an address we never answered must not be dialable")
+	}
+}
+
+// Deny must beat a broader allow at the resolver, not just at the dial.
+func TestDenyBeatsAllowAtResolution(t *testing.T) {
+	h, _, res := newGatedHandler(t, []string{"*.github.com"}, []string{"gist.github.com"}, "140.82.113.4")
+
+	if m := query(h, "api.github.com."); m.Rcode != dns.RcodeSuccess {
+		t.Errorf("allowed name: Rcode = %v, want SUCCESS", dns.RcodeToString[m.Rcode])
+	}
+	if m := query(h, "gist.github.com."); m.Rcode != dns.RcodeRefused {
+		t.Errorf("denied name: Rcode = %v, want REFUSED", dns.RcodeToString[m.Rcode])
+	}
+	if len(res.queried) != 1 {
+		t.Errorf("only the allowed name should reach upstream, got %v", res.queried)
+	}
+}
+
+// With no policy configured the handler must behave exactly as upstream does.
+func TestNilPolicyLeavesResolutionUnrestricted(t *testing.T) {
+	res := &stubResolver{addr: net.ParseIP("1.2.3.4")}
+	h := &dnsHandler{zones: []types.Zone{}, upstream: res, policy: nil}
+
+	m := query(h, "anything.example.org.")
+	if m.Rcode != dns.RcodeSuccess || len(m.Answer) != 1 {
+		t.Errorf("unrestricted mode should resolve normally: rcode=%v answers=%d",
+			dns.RcodeToString[m.Rcode], len(m.Answer))
+	}
+}
